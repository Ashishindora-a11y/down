####################################################################
# Clip Download API (Lite) - configuration
# Copy to .env for local use. On App Runner / Cloud Run, set these as
# environment variables or secrets instead of shipping a file.
####################################################################

# ---------- server ----------
# App Runner, Cloud Run, Render and Koyeb all inject PORT. Leave it unset there.
PORT=8080
# Dev server only (gunicorn uses --bind). 0.0.0.0 is required in a container;
# use 127.0.0.1 to run this as a personal app reachable only from your machine.
HOST=0.0.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json              # json (for CloudWatch/Cloud Logging) or text
ENABLE_UI=true               # set false for an API-only deployment
TRUST_PROXY_HEADERS=true     # read X-Forwarded-For (correct behind a managed LB)

# ---------- service mode ----------
# full     - relays bytes and runs ffmpeg. Needs Docker or a shell with ffmpeg.
#            Render, Koyeb, Cloud Run, a VPS, your own machine.
# resolver - metadata and CDN redirects only; no bytes pass through the service.
#            For hosts that cap response bodies or forbid native binaries.
#            Vercel is forced into this mode by api/index.py.
#            Trade-off: YouTube VIDEO cannot be served, because it has no
#            combined video+audio format and muxing needs ffmpeg. YouTube audio
#            and all of Instagram/TikTok/X/Facebook still work.
SERVICE_MODE=full

# ---------- authentication (READ THIS) ----------
# Comma-separated accepted keys. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving REQUIRE_API_KEY=true with an empty API_KEYS makes the service reject
# everything, which is a deliberate fail-closed default.
API_KEYS=replace-me-with-a-long-random-value
REQUIRE_API_KEY=true

# Browser origins allowed to call the API. Empty blocks all cross-origin calls.
# Using '*' exposes your API key to anyone reading your frontend source, so
# prefer calling from your own backend.
CORS_ORIGINS=

# ---------- clip limits (this is what makes it "lite") ----------
MAX_DURATION_SEC=300         # 5 min; a Reel/Short is well under this
MAX_FILESIZE_MB=250
# Measured on the SHORT side of the frame, so 1080 means 1080p whether the clip
# is landscape (1920x1080) or portrait (1080x1920). Capping on height instead
# would reject the best version of every Reel, Short and TikTok, since those
# are 1920 tall. MAX_HEIGHT still works as a deprecated alias.
MAX_QUALITY=1080
ALLOW_LIVE=false

# ---------- runtime guards ----------
# Keep below your platform's request cap:
#   App Runner  120s hard limit  -> 110 is right
#   Cloud Run   300s default, up to 3600 -> raise this if you raise that
SOFT_DEADLINE_SEC=110
MAX_CONCURRENT=4             # simultaneous transfers per instance
RATE_LIMIT_PER_MIN=20        # per API key (falls back to IP), per instance
RATE_LIMIT_PER_DAY=1000
SOCKET_TIMEOUT=20
CHUNK_SIZE_KB=256

# ---------- features ----------
# Keep this on for YouTube. YouTube has largely retired combined video+audio
# formats, so Shorts arrive as separate streams that ffmpeg has to mux. With
# this off, YouTube video requests fail; Instagram and TikTok still work
# because they serve single files.
ENABLE_SERVER_DOWNLOAD=true  # needs ffmpeg; enables audio conversion + muxing
ALLOW_GENERIC_EXTRACTOR=false # true also accepts bare media URLs and arbitrary pages
SSRF_GUARD=true              # KEEP ON: blocks cloud metadata and internal IPs
ALLOWED_DOMAINS=             # empty = every site yt-dlp supports
BLOCKED_DOMAINS=

# ---------- caching ----------
CACHE_TTL_SEC=300
CACHE_MAX_ENTRIES=512

# ---------- getting past platform bot checks ----------
# Datacenter IPs (App Runner, Cloud Run, EC2) get challenged far more often
# than residential ones. In rough order of effectiveness:
#
# 1) A residential or mobile proxy. The single biggest win for YouTube.
# PROXY=http://user:pass@host:port
#
# 2) Cookies from a logged-in session. Required for private or age-gated media.
#    Export a Netscape cookies.txt, then:
#      PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
#      bash:       base64 -w0 cookies.txt
#    Store the result as a secret (Secrets Manager / Secret Manager), not in git.
#    These are live session credentials: treat them like a password, and use a
#    throwaway account rather than your own.
# COOKIES_B64=
# COOKIES_FILE=/secrets/cookies.txt
#
# 3) TLS fingerprint impersonation (curl-cffi is bundled in the image).
# IMPERSONATE=chrome
#
# 4) Per-extractor tuning, as JSON. Swapping the YouTube player client often
#    clears "Sign in to confirm you're not a bot".
# EXTRACTOR_ARGS={"youtube":{"player_client":["android","web_safari"]}}
# USER_AGENT=

# ---------- scratch space ----------
# Cloud Run's filesystem is RAM-backed, so files written here consume the
# memory you are billed for. The proxy download path avoids disk entirely;
# only via=server writes anything, and it cleans up per request.
TMP_DIR=/tmp
